{
  // Taskclan Cloud console — deployed straight to Cloudflare from this repo.
  //
  // Not generated by the Taskclan engine, and that is the point: the console is
  // the control plane's UI, so it must not depend on the control plane's build
  // pipeline to ship. Everything here is committed and reviewable rather than
  // emitted at deploy time.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "taskclan-cloud-console",
  "main": "deploy/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true
  },

  // Non-secret configuration for the container.
  //
  // The Worker spreads every string binding into the container's environment,
  // so anything here (and every `wrangler secret put`) reaches the console as a
  // plain env var. Without this block the container received nothing but PORT —
  // it would have started and then failed on its first call to the engine.
  //
  // The secrets are set out of band and deliberately absent from this file:
  //   TASKCLAN_CLOUD_API_KEY  the console's Cloud API key
  //   CRYPTO_KEY              pg-meta's key for x-connection-encrypted
  //   PG_META_CRYPTO_KEY      the same value, as Studio names it
  //   TC_ACCESS_TOKEN         optional; enables the Worker's private-site gate
  "vars": {
    "TASKCLAN_CLOUD_URL": "https://engine.taskclan.com",
    // pg-meta runs inside this container, started by deploy/start.sh. Loopback
    // on purpose: the encrypted connection strings never leave the container.
    "STUDIO_PG_META_URL": "http://127.0.0.1:8090",
    "NODE_ENV": "production"
  },

  "containers": [
    {
      "class_name": "ConsoleContainer",
      // Built from the standalone output that CI produced. wrangler builds and
      // pushes this to Cloudflare's registry on deploy.
      "image": "./deploy/Dockerfile",
      // Context is deploy/, and that is load-bearing.
      //
      // wrangler does NOT honour a per-Dockerfile <name>.dockerignore the way
      // the docker CLI does; it uses the context root's .dockerignore. With the
      // repo root as context that is upstream Supabase's, which excludes
      // **/node_modules and **/.next — so wrangler pushed a 40 kB image with no
      // Next in it while CI's smoke test built a 765 MB one that served. Same
      // run, same Dockerfile, different images.
      //
      // deploy/ has exactly one .dockerignore and it is ours.
      "image_build_context": "./deploy",
      // Studio is a large Next app; `basic` is not enough to serve it warm.
      // "standard" is deprecated in favour of "standard-1"; wrangler warns on it.
      "instance_type": "standard-1",
      // One instance. The console is per-user and low-traffic, and a second
      // instance would only add cold starts.
      "max_instances": 1
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "CONSOLE",
        "class_name": "ConsoleContainer"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ConsoleContainer"]
    }
  ]
}
