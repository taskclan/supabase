{
  // Taskclan Cloud console — deployed straight to Cloudflare from this repo.
  //
  // Not generated by the Taskclan engine, and that is the point: the console is
  // the control plane's UI, so it must not depend on the control plane's build
  // pipeline to ship. Everything here is committed and reviewable rather than
  // emitted at deploy time.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "taskclan-cloud-console",
  "main": "deploy/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true
  },

  // The workers.dev URL, pinned ON deliberately.
  //
  // Wrangler disables workers.dev by default as soon as a `routes` block exists
  // and `workers_dev` does not. That is how this Worker went dark on
  // 2026-09-17: adding the custom domain turned workers.dev off, the custom
  // domain itself was then rejected, and the deploy left the Worker with no
  // route at all. Stating it explicitly means the fallback URL survives
  // whatever happens to the custom domain.
  "workers_dev": true,

  // THE SWITCH. This is what moves cloud.taskclan.com off the engine's console
  // and onto this one.
  //
  // A Workers Custom Domain rather than a route pattern: Cloudflare creates and
  // owns the DNS record and the certificate, so there is no separate DNS change
  // to keep in sync afterwards.
  //
  // The first attempt (3e7946c7c4) was rejected, and the rejection was correct:
  //
  //   Hostname 'cloud.taskclan.com' already has externally managed DNS records
  //   (A, CNAME, etc). Delete them first or try a different hostname. [100117]
  //
  // The hostname still carried the record pointing at the engine, and
  // Cloudflare will not silently take one over. That record has since been
  // deleted by hand; the hostname now has no A, AAAA or CNAME at all, which is
  // what lets this bind.
  //
  // Preconditions, both established and verified live before this landed:
  //
  //   1. TASKCLAN_SHARED_KEY_FALLBACK is "false" (c77b6384f3), so the API fails
  //      closed for a request carrying no user token rather than answering out
  //      of one organisation's shared key.
  //   2. TC_ACCESS_TOKEN is deleted. It was a single shared site password, and
  //      with this hostname pointing here it would have 401'd every real
  //      customer on the console UI.
  //
  // Reverting is NOT just deleting this block. A Workers Custom Domain owns the
  // DNS record it creates, so removing it removes the record and leaves the
  // hostname resolving to nothing. A rollback has to recreate a record pointing
  // back at the engine and re-add cloud.taskclan.com to CLOUD_HOSTS in the
  // engine's middleware — which is why that entry is being left in place until
  // this has soaked.
  "routes": [
    {
      "pattern": "cloud.taskclan.com",
      "custom_domain": true
    }
  ],

  // Non-secret configuration for the container.
  //
  // The Worker spreads every string binding into the container's environment,
  // so anything here (and every `wrangler secret put`) reaches the console as a
  // plain env var. Without this block the container received nothing but PORT —
  // it would have started and then failed on its first call to the engine.
  //
  // The secrets are set out of band and deliberately absent from this file:
  //   TASKCLAN_CLOUD_API_KEY  the console's Cloud API key
  //   CRYPTO_KEY              pg-meta's key for x-connection-encrypted
  //   PG_META_CRYPTO_KEY      the same value, as Studio names it
  //   TC_ACCESS_TOKEN         optional; enables the Worker's private-site gate
  "vars": {
    "TASKCLAN_CLOUD_URL": "https://engine.taskclan.com",
    // Cutover step 1 of 3. With per-user auth live, a request that arrives with
    // no user token must fail rather than quietly act as the shared Cloud API
    // key — which would mean serving one organisation's apps to whoever asked.
    //
    // This has to go off BEFORE TC_ACCESS_TOKEN comes off, not after. The site
    // password is currently the only thing in front of /api/taskclan/*; drop it
    // while this fallback is still on and those routes answer anonymously out
    // of the shared key. Ordering them the other way round is the difference
    // between a closed door and an open one.
    //
    // Runtime rather than build-time on purpose: if this turns out to be wrong,
    // recovery is editing this value, not waiting out a rebuild.
    "TASKCLAN_SHARED_KEY_FALLBACK": "false",
    // The shared Supabase project every Taskclan app connects to via
    // supabase-js. The Connect panel's Framework/Mobile/Server tabs surface this
    // REST URL + the anon key (TASKCLAN_SUPABASE_ANON_KEY, a Worker secret). The
    // anon key is public by design — it already ships in every app's client
    // bundle — so this is not a new exposure; it maps to the shared `anon` role
    // (RLS-governed), NOT per-app isolation. Per-app isolation is the connection
    // string (a scoped role). The service_role key is never surfaced.
    "TASKCLAN_SUPABASE_URL": "https://ydpfystsgydquencpfyy.supabase.co",
    // pg-meta runs inside this container, started by deploy/start.sh. Loopback
    // on purpose: the encrypted connection strings never leave the container.
    "STUDIO_PG_META_URL": "http://127.0.0.1:8090",
    // Where the SQL editor stores saved queries. The fork keeps snippets on the
    // container filesystem; unset, the content endpoints throw and the editor
    // hangs on a spinner. /tmp is writable in the container. NOTE: this disk is
    // per-instance and does not survive a container restart, so saved queries
    // are session-scoped until snippets move to the database.
    "SNIPPETS_MANAGEMENT_FOLDER": "/tmp/tc-snippets",
    "NODE_ENV": "production"
  },

  "containers": [
    {
      "class_name": "ConsoleContainer",
      // Built from the standalone output that CI produced. wrangler builds and
      // pushes this to Cloudflare's registry on deploy.
      "image": "./deploy/Dockerfile",
      // Context is deploy/, and that is load-bearing.
      //
      // wrangler does NOT honour a per-Dockerfile <name>.dockerignore the way
      // the docker CLI does; it uses the context root's .dockerignore. With the
      // repo root as context that is upstream Supabase's, which excludes
      // **/node_modules and **/.next — so wrangler pushed a 40 kB image with no
      // Next in it while CI's smoke test built a 765 MB one that served. Same
      // run, same Dockerfile, different images.
      //
      // deploy/ has exactly one .dockerignore and it is ours.
      "image_build_context": "./deploy",
      // Studio is a large Next app; `basic` is not enough to serve it warm.
      // "standard" is deprecated in favour of "standard-1"; wrangler warns on it.
      "instance_type": "standard-1",
      // One instance. The console is per-user and low-traffic, and a second
      // instance would only add cold starts.
      "max_instances": 1
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "CONSOLE",
        "class_name": "ConsoleContainer"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ConsoleContainer"]
    }
  ]
}
