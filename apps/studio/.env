# TODO: evaluate these variables at runtime instead
# https://nextjs.org/docs/basic-features/environment-variables#loading-environment-variables
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Auth/identity: the console signs users into the SHARED Taskclan engine GoTrue
# (project ydpfystsgydquencpfyy) so a console user IS a Cloud user and their JWT
# validates at engine.taskclan.com's /api/cloud/v1/*. Set literally, NOT derived
# from SUPABASE_PUBLIC_URL (that stays the self-hosted gateway at localhost:8000).
NEXT_PUBLIC_GOTRUE_URL=https://ydpfystsgydquencpfyy.supabase.co/auth/v1
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=10000000-ffff-ffff-ffff-000000000001

# CmdK / AI + dashboard identity — same engine project as GOTRUE above.
