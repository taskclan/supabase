# Reveal the multi-tenant console (user's real orgs, Buy-a-domain nav). Pairs
# with the server-side TASKCLAN_MULTI_TENANT in wrangler.jsonc. Requires the
# Phase-1 code (taskclan/supabase#29) to be deployed first.
NEXT_PUBLIC_TASKCLAN_MULTI_TENANT=true

