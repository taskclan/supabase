{
  // Second probe: the CONSOLE's own image, under the minimal Worker.
  //
  // The first probe proved Cloudflare honours an image ENTRYPOINT and that our
  // instance type, port and bindings are fine. That leaves two suspects for the
  // console: its image, or its Worker class (envVars, enableInternet,
  // sleepAfter, the gate). This separates them without a seven-minute rebuild,
  // by pointing at the image already in the registry.
  //
  // Serves  -> the image is fine; the fault is in ConsoleContainer.
  // Exits 0 -> the image is at fault, whatever the Worker does.
  "name": "taskclan-console-probe",
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "ProbeContainer",
      "image": "registry.cloudflare.com/f4f001adb3aa142f207f1e5d736efafa/taskclan-cloud-console-consolecontainer@sha256:b3333fca2a95f59d4f794938071aca3176468ff2646375345af48b9b8bd9c208",
      "instance_type": "standard-1",
      "max_instances": 1
    }
  ],
  "durable_objects": { "bindings": [{ "name": "PROBE", "class_name": "ProbeContainer" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ProbeContainer"] }]
}
