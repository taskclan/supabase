# The console's payload, with a trivial app in place of Next.
#
# Built from the same staged deploy/app tree the console ships — same bulk,
# same file count, same pnpm symlinks — but started by a five-line HTTP server
# instead of the Next standalone runtime.
#
# That question is answered: it serves. So this now runs the DIAGNOSTIC
# entrypoint instead, which listens first and then reports what Next throws.
FROM node:22-slim
ENV PORT=8080
COPY deploy/app/ ./
COPY deploy/probe/diagnose.js /srv/diagnose.js
EXPOSE 8080
ENTRYPOINT ["node", "/srv/diagnose.js"]
